APP_NAME=OpenLMNP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie de session « Secure » : laissé non réglé, il l'est automatiquement sur une requête
# HTTPS et sur le nom d'hôte d'un APP_URL en https ; une instance du réseau local servie en
# HTTP continue de fonctionner. true/false pour forcer.
# SESSION_SECURE_COOKIE=

# En-têtes de sécurité (config/security.php). Politique de sécurité du contenu (CSP) active
# par défaut ; HSTS posé seulement sur les requêtes HTTPS.
# CSP_ENABLED=true
# CSP_REPORT_ONLY=false
# CSP_EXTRA_SOURCES=
# CSP_POLICY=
# HSTS_MAX_AGE=31536000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# MCP Server (Model Context Protocol)
MCP_ENABLED=false
MCP_RATE_LIMIT=60
MCP_FILE_PATH_PREFIX=
# Compte authentifié en transport stdio (php artisan mcp:start openlmnp) ;
# vide = l'unique compte réel de l'instance
OPENLMNP_MCP_USER=

# Token MCP démo public (lecture seule) — adossé au compte démo à données fictives.
# Permet aux annuaires MCP / curieux d'essayer le serveur sans compte.
# Après activation : php artisan openlmnp:mcp-demo-token
MCP_DEMO_ENABLED=false
# Valeur brute stable du token public (SANS caractère « | »).
MCP_DEMO_TOKEN=
# Requêtes/minute par IP (token partagé).
MCP_DEMO_RATE_LIMIT=20

# Coffre-fort des justificatifs : chiffrement des fichiers déposés avec une phrase
# de passe choisie par l'utilisateur, que l'instance ne connaît pas. Optionnel et
# désactivé par défaut pour chaque compte ; ce drapeau masque la fonctionnalité sur
# toute l'instance.
DOCUMENTS_VAULT_ENABLED=true
# Coût de la dérivation Argon2id au déverrouillage : moderate (≈ 500 ms, 256 Mo),
# interactive (≈ 80 ms, 64 Mo) sur un serveur modeste, test (réservé à la suite Pest).
DOCUMENTS_VAULT_KDF=moderate
# Durée d'inactivité, en minutes, avant re-verrouillage (défaut : SESSION_LIFETIME).
DOCUMENTS_VAULT_TTL=120

# Estimation de la valeur vénale d'après les ventes DVF (data.gouv.fr).
# Appel sortant, uniquement sur clic explicite de l'utilisateur : la commune du bien
# est transmise à data.gouv.fr (jamais un montant ni une adresse).
# Mettre à false pour retirer entièrement le bouton « Estimer (DVF) ».
# DVF_ENABLED=true
# DVF_MIN_SAMPLE=5

# Autocomplétion d'adresse par la Base Adresse Nationale (API Adresse, data.geopf.fr).
# Second appel sortant du logiciel, et le plus bavard : il révèle à la Géoplateforme de l'IGN le
# début d'adresse en cours de frappe, sur les écrans qui en demandent une. Il ne part
# qu'à partir de trois caractères et après 300 ms sans frappe.
# Mettre à false pour le couper : le script n'est alors même pas injecté dans les pages,
# et la saisie d'adresse redevient entièrement manuelle (elle l'est déjà — aucune
# validation ne dépend de ce service).
# ADDRESS_LOOKUP_ENABLED=true
# ADDRESS_LOOKUP_TIMEOUT=3

# Vérification Sirene du SIREN saisi dans le profil (API Recherche d'entreprises, DINUM).
# Appel sortant, uniquement sur clic explicite de l'utilisateur : seul le SIREN saisi est
# transmis. Mettre à false pour retirer entièrement le bouton « Vérifier dans Sirene ».
# SIRENE_ENABLED=true

# Dossiers liés : dossiers d'indivision offerts, partagés entre indivisaires, ouverts par
# bascule depuis un compte principal. Désactivé par défaut. Le quota de dossiers qu'un compte
# peut créer est illimité en auto-hébergement sauf si LINKED_DOSSIERS_QUOTA est renseignée
# (plafond global ; `php artisan openlmnp:dossier-quota` pose un plafond propre à un compte).
# LINKED_DOSSIERS_ENABLED=false
# LINKED_DOSSIERS_QUOTA=

# Recherche du DPE d'après la base de l'ADEME (data.ademe.fr) et la Géoplateforme (IGN).
# Uniquement sur clic explicite de l'utilisateur (bouton « Retrouver le DPE ») : l'adresse
# du bien est alors transmise à l'IGN puis à l'ADEME. Mettre à false pour retirer
# entièrement le bouton.
# DPE_ENABLED=true

# Repère de loyer du simulateur — « Carte des loyers » (ANIL, data.gouv.fr).
# Aucun appel sur clic : `openlmnp:refresh-rent-map --if-missing`, planifiée chaque jour,
# DÉCOUVRE automatiquement le millésime suivant sur l'API data.gouv.fr (table vide mise à
# part, aucun appel avant le 1er novembre) et le simulateur ne fait que lire la table qui en
# résulte. Mettre à false pour couper l'import planifié et retirer le repère du simulateur.
# RENT_MAP_ENABLED=true
# RENT_MAP_API_BASE_URL=https://www.data.gouv.fr/api/1/datasets
# RENT_MAP_PAGE_BASE_URL=https://www.data.gouv.fr/datasets
# RENT_MAP_TIMEOUT=8

# Mode démo (sandbox éphémère par visiteur)
DEMO_MODE=false
DEMO_TTL_HOURS=24
DEMO_MAX_ACCOUNTS=200
# Compte démo fixe (seedé par DemoSeeder, aussi utilisé par le token MCP démo)
DEMO_EMAIL=demo@openlmnp.fr

# Inscription publique (page /register) :
# - auto (défaut) : ouverte uniquement jusqu'à la création du premier compte
# - true : toujours ouverte (plusieurs comptes sur l'instance)
# - false : toujours fermée (comptes créés par provisioning ou CLI)
ALLOW_REGISTRATION=auto

# Durée de validité d'une invitation, en jours (mode ALLOW_REGISTRATION=invite).
# Volontairement indépendante du délai des liens « mot de passe oublié » (60 min) :
# une invitation part vers une boîte qu'on relève peut-être le lendemain.
INVITATION_TTL_DAYS=14

# API de provisioning de comptes (POST /api/admin/users). Désactivée (404)
# tant que ce jeton est vide. Générer par ex. avec : openssl rand -hex 32
PROVISION_TOKEN=

# Google Tag Manager (optionnel — désactivé si GTM_CONTAINER_ID est vide)
GTM_CONTAINER_ID=
GTM_SERVER_URL=
GTM_SCRIPT_PATH=

# Lien « Découvrir OpenLMNP » affiché sur /login (site officiel du projet).
# Laisser vide pour masquer ce lien sur une instance auto-hébergée.
OPENLMNP_WEBSITE_URL=https://openlmnp.fr

# Intelligence artificielle (OpenRouter, ou tout serveur compatible OpenAI)
# Interrupteur général : false = aucune interface IA n'apparaît.
AI_ENABLED=false
# Fournisseur : auto (déduit de AI_BASE_URL, OpenRouter à défaut), openrouter,
# anthropic, gemini, mistral, openai, ou local pour tout serveur compatible
# OpenAI installé chez vous. OpenRouter, Anthropic et Gemini reçoivent un PDF
# tel quel ; ailleurs la couche texte est extraite, et un scan doit être déposé
# en image.
AI_PROVIDER=auto
# Point d'entrée. Vide = adresse par défaut du fournisseur ci-dessus ; une
# valeur renseignée prime toujours (proxy, passerelle d'entreprise). Pour rester
# 100% local : AI_BASE_URL=http://ollama:11434/v1 — les PDF sont alors envoyés
# sous forme de texte extrait (voir AI_PDF_TEXT_FALLBACK), les scans en images.
AI_BASE_URL=
# Clé d'instance : si renseignée, elle sert à tous les comptes et les
# utilisateurs ne voient aucun champ « clé » dans leur profil.
AI_API_KEY=
# Autorise chaque utilisateur à saisir sa propre clé dans Mon profil.
AI_ALLOW_USER_KEYS=true
# Bouton « Se connecter avec OpenRouter » dans Mon profil : la clé est délivrée
# par le fournisseur sans copier-coller, et elle appartient à l'utilisateur.
# L'instance n'a pas besoin d'être joignable depuis Internet — c'est le
# navigateur qui fait l'aller-retour — mais ne mettez pas SESSION_SAME_SITE=strict.
AI_OAUTH_ENABLED=true

# Modèles, changeables sans déploiement. Vide = modèle par défaut du fournisseur
# configuré ci-dessus (chez OpenRouter : google/gemini-3.7-flash). ⚠️ Les slugs ne
# sont pas portables d'un fournisseur à l'autre — laisser vide est le choix sûr.
AI_MODEL_DOCUMENTS=
# Modèle de repli si l'extraction échoue ou manque de confiance. Vide = celui du
# fournisseur ; « none » désactive la cascade (aucun second appel facturé).
# Une confiance basse signifie presque toujours un document mal lisible : le repli
# vise donc la qualité de lecture (OCR) avant tout.
AI_MODEL_DOCUMENTS_FALLBACK=
# Seuil de confiance (0-1) sous lequel le modèle de repli est appelé.
AI_FALLBACK_CONFIDENCE=0.6
# Seuil (0-1) au-dessus duquel le bouton « Réanalyser avec le modèle renforcé »
# est masqué : l'extraction est jugée sûre, un appel de plus serait inutile.
AI_REANALYSIS_THRESHOLD=0.85
AI_MODEL_CHAT=
# Effort de raisonnement demandé au modèle, par fonction : low (défaut), medium,
# high, ou none pour ne pas envoyer le paramètre. Sur Gemini 3.x Flash, le
# raisonnement est facturé et consomme le budget de réponse : low le ramène à 0.
AI_CHAT_REASONING=low
AI_DOCS_REASONING=low

# Moteur de lecture des PDF du service OpenRouter (sans effet sur un autre
# serveur) : native (le modèle lit le PDF), pdf-text ou cloudflare-ai
# (gratuits, texte seul), mistral-ocr (payant, scans).
AI_PDF_ENGINE=native

# Envoi des PDF sous forme de texte extrait plutôt que de fichier, pour les
# serveurs qui ne savent pas recevoir de PDF : auto (dès que AI_BASE_URL n'est
# pas OpenRouter), always, never. Un PDF scanné n'a pas de couche texte : il
# reste à envoyer en image.
AI_PDF_TEXT_FALLBACK=auto

# Quotas par utilisateur (0 = illimité) : mois civil pour les documents,
# jour civil pour l'assistant. Ignorés si l'utilisateur fournit sa propre clé.
AI_DOCS_MONTHLY_QUOTA=0
AI_CHAT_DAILY_QUOTA=0
# Dépense maximale de TOUTE l'instance sur sa clé, en dollars par jour (UTC). Atteinte, l'IA
# se met en pause jusqu'au lendemain ; les clés personnelles ne sont pas concernées. 0 = désactivé.
AI_DAILY_BUDGET_USD=0
AI_QUOTA_APPLIES_TO_USER_KEYS=false

# Assistant conversationnel : longueur max d'une conversation et nombre max
# d'appels d'outils par question.
AI_CHAT_MAX_TURNS=20
AI_CHAT_TOOL_CALLS_MAX=4

# Délai HTTP en secondes (l'analyse tourne dans la requête).
AI_TIMEOUT=60
# Politique de conservation demandée au fournisseur : deny = ne conserve ni
# n'entraîne sur les données transmises.
AI_DATA_COLLECTION=deny
# En-têtes d'attribution recommandés par OpenRouter.
AI_APP_REFERER=https://openlmnp.fr
AI_APP_TITLE=OpenLMNP
# Rétention du journal d'usage IA, en jours (purge quotidienne).
AI_USAGE_RETENTION=90
# Tarifs des modèles, en dollars par MILLION de jetons — utile uniquement chez
# un fournisseur qui ne renvoie pas le coût réel de l'appel (tous sauf
# OpenRouter). Sans eux, le journal et l'écran d'administration n'affichent
# aucun coût, ce qui vaut mieux qu'un chiffre inventé. Objet JSON sur une ligne :
# AI_MODEL_PRICES={"gemini-3.7-flash":{"in":"0.375","out":"1.875"}}
AI_MODEL_PRICES=

# Page où obtenir un compte quand l'inscription publique est fermée
# (ALLOW_REGISTRATION=false, ou `auto` une fois le premier compte créé). Renseignée,
# /register y redirige au lieu d'être un cul-de-sac, et /login gagne un lien
# « Créer un compte ». Vide : /register renvoie vers /login avec une explication,
# et seul le lien neutre ci-dessus s'affiche.
OPENLMNP_SIGNUP_URL=

# Mise à jour en place depuis le panel (page « Mises à jour ») et via app:auto-update.
# Nécessite rsync, composer et npm sur le serveur, et un code modifiable : vrai pour une
# install classique, faux pour l'image Docker officielle (immuable, .env.docker force
# false → mise à jour par `docker pull` + recréation du conteneur).
UPDATE_SELF_APPLY=true
# Dépôt GitHub d'où viennent les mises à jour. Ne pas changer sans raison : le code
# téléchargé est installé et exécuté tel quel.
GITHUB_REPO=manganate006/openlmnp
UPDATE_DOCKER_IMAGE=manganate06/openlmnp:latest
